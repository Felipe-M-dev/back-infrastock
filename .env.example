NODE_ENV=development
PORT=3000

# Runtime NestJS: usuario sin ownership ni privilegios administrativos.
DATABASE_URL="postgresql://infrastock_app:<RUNTIME_DB_PASSWORD>@localhost:5432/infrastock?schema=public"

# Prisma CLI / migraciones: usuario propietario de los objetos.
DATABASE_MIGRATION_URL="postgresql://infrastock_owner:<MIGRATION_DB_PASSWORD>@localhost:5432/infrastock?schema=public"

# Solo para prisma migrate dev. En QAS/PRD usar prisma migrate deploy.
SHADOW_DATABASE_URL="postgresql://infrastock_owner:<MIGRATION_DB_PASSWORD>@localhost:5432/infrastock_shadow?schema=public"

# Pool por réplica.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=30000

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<CHANGE_ME_MIN_12_CHARS>
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=

JWT_SECRET=<CHANGE_ME_MIN_32_RANDOM_BYTES>
JWT_EXPIRES_IN=8h
JWT_ISSUER=infrastock-api
JWT_AUDIENCE=infrastock-web

FRONTEND_URL=http://localhost:5173
# FRONTEND_URLS=https://infrastock.example.cl,https://infrastock-admin.example.cl

# 0 directo; normalmente 1 si existe un único Nginx/Ingress confiable.
TRUST_PROXY_HOPS=0

# Rate limit por proceso/instancia.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# Debe ser almacenamiento persistente en contenedor/Kubernetes.
MEDIA_STORAGE_DIR=./storage/media

ENDOFLIFE_API_BASE_URL=https://endoflife.date/api/v1
ENDOFLIFE_CACHE_TTL_SECONDS=21600
ENDOFLIFE_TIMEOUT_MS=5000
ENDOFLIFE_EOL_SOON_DAYS=180

BCCH_API_URL=https://si3.bcentral.cl/SieteRestWS/SieteRestWS.ashx
BCCH_API_TOKEN=<CHANGE_ME>
BCCH_UF_SERIES=F073.UFF.PRE.Z.D
BCCH_TIMEOUT_MS=5000

CREDENTIAL_MASTER_KEY=<CHANGE_ME_WITH_32_BYTE_BASE64_KEY_AND_ROTATION_PLAN>
CREDENTIAL_KEY_VERSION=1

SERVER_IMPORT_PROCESSING_TIMEOUT_MINUTES=30

CREDENTIAL_SECRET_MAX_ACCESSES=20
CREDENTIAL_SECRET_WINDOW_SECONDS=600
CREDENTIAL_SECRET_BLOCK_SECONDS=600

# Health checks públicos y sin secretos:
# GET /health/live
# GET /health/ready
